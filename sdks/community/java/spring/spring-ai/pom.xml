<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ag-ui.community</groupId>
    <artifactId>ag-ui-spring-ai-parent</artifactId>
    <!--
      The Spring AI line, released as a self-contained reactor. Versioned as one
      unit tracking the Spring AI line it targets (2.x); every module below shares
      this version. Kept independent of the spring-boot line so the two release on
      separate cadences. Self-contained (no external parent) so each published
      module's POM ancestry resolves without an unpublished parent.
    -->
    <version>2.0.0</version>
    <packaging>pom</packaging>

    <name>ag-ui-spring-ai-parent</name>
    <description>Reactor for the AG-UI Spring AI modules (the ChatClient adapter and its Boot starters)</description>
    <url>https://github.com/ag-ui-protocol/ag-ui</url>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>pascalwilbrink</id>
            <name>Pascal Wilbrink</name>
            <email>pascal.wilbrink@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/ag-ui-protocol/ag-ui.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/ag-ui-protocol/ag-ui.git</developerConnection>
        <url>https://github.com/ag-ui-protocol/ag-ui</url>
    </scm>

    <modules>
        <module>spring-ai</module>
        <module>spring-ai-spring-boot-starter</module>
        <module>spring-ai-webmvc-boot-starter</module>
    </modules>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- ag-ui is published to Maven Central, so resolve the release directly. -->
        <ag-ui.version>0.1.1</ag-ui.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <!-- Reactor train matching the Spring AI / Spring 6.2 line. -->
        <reactor-bom.version>2024.0.12</reactor-bom.version>
        <!-- Spring Boot autoconfigure/test used by the Boot starters in this line. -->
        <spring-boot.version>4.1.0</spring-boot.version>
        <!--
          The spring-boot server line this line consumes. It is released as its own
          reactor (see ../spring-boot); its artifacts must be available (locally or
          on Maven Central) before this line is built or released.
        -->
        <ag-ui-spring-server.version>4.1.0</ag-ui-spring-server.version>
        <junit.version>5.10.2</junit.version>
        <jacoco.version>0.8.13</jacoco.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring AI's BOM does not manage Reactor, so manage it here. -->
            <dependency>
                <groupId>io.projectreactor</groupId>
                <artifactId>reactor-bom</artifactId>
                <version>${reactor-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Pins Spring Boot (autoconfigure, test) for the Boot starters. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ag-ui-4j core module used by the adapter. -->
            <dependency>
                <groupId>com.ag-ui.community</groupId>
                <artifactId>java-core</artifactId>
                <version>${ag-ui.version}</version>
            </dependency>

            <!-- Internal module of this line, at the shared reactor version. -->
            <dependency>
                <groupId>com.ag-ui.community</groupId>
                <artifactId>ag-ui-spring-ai</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Server line consumed by the Boot starters (separate reactor/version). -->
            <dependency>
                <groupId>com.ag-ui.community</groupId>
                <artifactId>ag-ui-spring-webflux-server</artifactId>
                <version>${ag-ui-spring-server.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ag-ui.community</groupId>
                <artifactId>ag-ui-spring-webmvc-server</artifactId>
                <version>${ag-ui-spring-server.version}</version>
            </dependency>

            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Produces the per-module coverage report at
                 target/site/jacoco/jacoco.xml. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Activated when publishing to Maven Central (see
             .github/workflows/publish-release.yml). -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!-- Inline the reactor parent and resolve property/managed versions
                         into each module's published POM, so a consumer never needs this
                         aggregator parent on Maven Central. -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>flatten-maven-plugin</artifactId>
                        <version>1.7.0</version>
                        <configuration>
                            <flattenMode>oss</flattenMode>
                        </configuration>
                        <executions>
                            <execution>
                                <id>flatten</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>flatten</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>flatten-clean</id>
                                <phase>clean</phase>
                                <goals>
                                    <goal>clean</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Attach a sources jar (required by Maven Central). -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Attach a javadoc jar (required by Maven Central). -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>none</doclint>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Sign all artifacts with GPG (required by Maven Central).
                         The passphrase is read from the MAVEN_GPG_PASSPHRASE env var. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Publish to Maven Central via the Central Publishing Portal.
                         Credentials come from the "central" server in settings.xml. -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
