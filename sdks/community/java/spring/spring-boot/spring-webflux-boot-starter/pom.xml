<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ag-ui.community</groupId>
        <artifactId>ag-ui-spring-boot-parent</artifactId>
        <version>4.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ag-ui-spring-webflux-boot-starter</artifactId>

    <name>ag-ui-spring-webflux-boot-starter</name>
    <description>Spring Boot starter that exposes an AG-UI Agent over a reactive (WebFlux) SSE endpoint</description>

    <!--
      A dependency-only starter: add it and define a single Agent bean to get a
      working /agent endpoint. The WebFlux server, Jackson serializer and Spring
      Boot auto-configuration come transitively from ag-ui-spring-webflux-server.
    -->
    <dependencies>
        <dependency>
            <groupId>com.ag-ui.community</groupId>
            <artifactId>ag-ui-spring-webflux-server</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!-- This dependency-only starter has no Java sources or API docs.
                         Central still requires both archives: ship its dependency
                         declaration and usage documentation instead. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <version>3.4.2</version>
                        <executions>
                            <execution>
                                <id>attach-starter-sources</id>
                                <phase>package</phase>
                                <goals><goal>jar</goal></goals>
                                <configuration>
                                    <classifier>sources</classifier>
                                    <classesDirectory>${project.basedir}</classesDirectory>
                                    <includes>
                                        <include>pom.xml</include>
                                        <include>README.md</include>
                                    </includes>
                                </configuration>
                            </execution>
                            <execution>
                                <id>attach-starter-javadocs</id>
                                <phase>package</phase>
                                <goals><goal>jar</goal></goals>
                                <configuration>
                                    <classifier>javadoc</classifier>
                                    <classesDirectory>${project.basedir}</classesDirectory>
                                    <includes>
                                        <include>pom.xml</include>
                                        <include>README.md</include>
                                    </includes>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
