{
  "name": "run-error-success-run-error",
  "area": "lifecycle",
  "description": "a failed run, a run that succeeds and a run that fails again, on one stream: RUN_ERROR ends whatever its run had open along with the run, so the run after it starts with nothing open and may finish; the half-written message of the failed run stays; and the stream is consumed, each failure delivered as an event. Local to this repository: the upstream corpus has one failed run followed by one that succeeds",
  "specPage": "/spec/1.0/events/lifecycle",
  "kill": "carry what a failed run left open into the run after it, so that run's RUN_FINISHED is rejected for the message the failed run abandoned; or stop reading at the first RUN_ERROR",
  "stream": [
    {
      "type": "RUN_STARTED",
      "threadId": "t-run-error-success-run-error",
      "runId": "run-error-success-run-error-r-1",
      "protocolVersion": "1.0"
    },
    {
      "type": "TEXT_MESSAGE_START",
      "messageId": "run-error-success-run-error-m-1",
      "role": "assistant"
    },
    {
      "type": "TEXT_MESSAGE_CONTENT",
      "messageId": "run-error-success-run-error-m-1",
      "delta": "half a sen"
    },
    { "type": "STEP_STARTED", "stepName": "run-error-success-run-error-step" },
    {
      "type": "RUN_ERROR",
      "message": "run-error-success-run-error: run 1 failed"
    },
    {
      "type": "RUN_STARTED",
      "threadId": "t-run-error-success-run-error",
      "runId": "run-error-success-run-error-r-2",
      "protocolVersion": "1.0"
    },
    { "type": "STEP_STARTED", "stepName": "run-error-success-run-error-step" },
    {
      "type": "TEXT_MESSAGE_START",
      "messageId": "run-error-success-run-error-m-2",
      "role": "assistant"
    },
    {
      "type": "TEXT_MESSAGE_CONTENT",
      "messageId": "run-error-success-run-error-m-2",
      "delta": "second run"
    },
    { "type": "TEXT_MESSAGE_END", "messageId": "run-error-success-run-error-m-2" },
    { "type": "STEP_FINISHED", "stepName": "run-error-success-run-error-step" },
    {
      "type": "RUN_FINISHED",
      "threadId": "t-run-error-success-run-error",
      "runId": "run-error-success-run-error-r-2"
    },
    {
      "type": "RUN_STARTED",
      "threadId": "t-run-error-success-run-error",
      "runId": "run-error-success-run-error-r-3",
      "protocolVersion": "1.0"
    },
    {
      "type": "RUN_ERROR",
      "message": "run-error-success-run-error: run 3 failed",
      "code": "UNAVAILABLE"
    }
  ],
  "expect": {
    "outcome": "completed",
    "noWarnings": true,
    "runError": "run-error-success-run-error: run ",
    "eventTypes": [
      "RUN_STARTED",
      "TEXT_MESSAGE_START",
      "TEXT_MESSAGE_CONTENT",
      "STEP_STARTED",
      "RUN_ERROR",
      "RUN_STARTED",
      "STEP_STARTED",
      "TEXT_MESSAGE_START",
      "TEXT_MESSAGE_CONTENT",
      "TEXT_MESSAGE_END",
      "STEP_FINISHED",
      "RUN_FINISHED",
      "RUN_STARTED",
      "RUN_ERROR"
    ],
    "messageCount": 2,
    "messages": [
      { "id": "run-error-success-run-error-m-1", "role": "assistant", "content": "half a sen" },
      { "id": "run-error-success-run-error-m-2", "role": "assistant", "content": "second run" }
    ],
    "end": {
