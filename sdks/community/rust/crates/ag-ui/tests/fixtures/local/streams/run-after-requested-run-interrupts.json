{
  "name": "run-after-requested-run-interrupts",
  "area": "lifecycle",
  "description": "a producer that keeps the stream open after the requested run sends a run the request did not ask for; the agent then stands where that run left it, so its interrupt outcome is what the thread is paused on and how the request went. Local to this repository: 1.0 makes the requested run the last of its exchange and says nothing of a consumer that meets one after it; `input.runId` names the run asked for, and `end`, `runs` and `pendingInterrupts` are read on the thread lane only",
  "specPage": "/spec/1.0/basic/patterns/interrupt-resume",
  "kill": "let only the requested run decide what the thread owes, so the interrupt of the run after it is reported in `runs` and never becomes pending",
  "input": { "runId": "run-after-requested-interrupts-r-1" },
  "stream": [
    {
      "type": "RUN_STARTED",
      "threadId": "t-run-after-requested-interrupts",
      "runId": "run-after-requested-interrupts-r-1",
      "protocolVersion": "1.0"
    },
    {
      "type": "TEXT_MESSAGE_START",
      "messageId": "run-after-requested-interrupts-m-1",
      "role": "assistant"
    },
    {
      "type": "TEXT_MESSAGE_CONTENT",
      "messageId": "run-after-requested-interrupts-m-1",
      "delta": "requested run"
    },
    { "type": "TEXT_MESSAGE_END", "messageId": "run-after-requested-interrupts-m-1" },
    {
      "type": "RUN_FINISHED",
      "threadId": "t-run-after-requested-interrupts",
      "runId": "run-after-requested-interrupts-r-1",
      "outcome": { "type": "success" }
    },
    {
      "type": "RUN_STARTED",
      "threadId": "t-run-after-requested-interrupts",
      "runId": "run-after-requested-interrupts-r-2",
      "protocolVersion": "1.0"
    },
    {
      "type": "TEXT_MESSAGE_START",
      "messageId": "run-after-requested-interrupts-m-2",
      "role": "assistant"
    },
    {
      "type": "TEXT_MESSAGE_CONTENT",
      "messageId": "run-after-requested-interrupts-m-2",
      "delta": "May I proceed?"
    },
    { "type": "TEXT_MESSAGE_END", "messageId": "run-after-requested-interrupts-m-2" },
    {
      "type": "RUN_FINISHED",
      "threadId": "t-run-after-requested-interrupts",
      "runId": "run-after-requested-interrupts-r-2",
      "outcome": {
        "type": "interrupt",
        "interrupts": [{ "id": "run-after-requested-interrupts-i-1", "reason": "approval" }]
      }
    }
  ],
  "expect": {
    "outcome": "completed",
    "noWarnings": true,
    "messageCount": 2,
    "messages": [
      { "id": "run-after-requested-interrupts-m-1", "content": "requested run" },
      { "id": "run-after-requested-interrupts-m-2", "content": "May I proceed?" }
    ],
    "end": {
      "Interrupted": { "interrupts": [{ "id": "run-after-requested-interrupts-i-1" }] }
    },
    "runs": [
      { "runId": "run-after-requested-interrupts-r-1", "requested": true, "end": "Success" },
      { "runId": "run-after-requested-interrupts-r-2", "requested": false, "end": "Interrupted" }
    ],
    "pendingInterrupts": ["run-after-requested-interrupts-i-1"]
  }
}
