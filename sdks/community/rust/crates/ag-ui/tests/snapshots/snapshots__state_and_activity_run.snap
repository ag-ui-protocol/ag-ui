---
source: crates/ag-ui-core/tests/snapshots.rs
expression: "vec![Event::state_snapshot(json!({ \"counter\": 1, \"items\": [] })),\nEvent::state_delta(vec![PatchOperation::replace(\"/counter\", json!(2)),\nPatchOperation::add(\"/items/-\", json!(\"first\")),\nPatchOperation::test(\"/counter\", json!(2)),]),\nEvent::activity_snapshot(\"msg-4\", \"web_search\", content),\nEvent::activity_delta(\"msg-4\", \"web_search\",\nvec![PatchOperation::replace(\"/results\", json!(3))],),\nEvent::messages_snapshot(vec![Message::user(\"msg-0\", \"What's the weather?\"),\nMessage::assistant(\"msg-1\", \"18C and raining.\"),]),]"
---
[
  {
    "type": "STATE_SNAPSHOT",
    "snapshot": {
      "counter": 1,
      "items": []
    }
  },
  {
    "type": "STATE_DELTA",
    "delta": [
      {
        "op": "replace",
        "path": "/counter",
        "value": 2
      },
      {
        "op": "add",
        "path": "/items/-",
        "value": "first"
      },
      {
        "op": "test",
        "path": "/counter",
        "value": 2
      }
    ]
  },
  {
