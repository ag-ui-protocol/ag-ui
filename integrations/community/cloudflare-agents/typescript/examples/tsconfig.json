{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    // The adapter is linked from the repo, so without this its `ai` import
    // would resolve to the repo root's copy. Installed from npm, `ai` is a
    // peer dependency and there is only one copy.
    "paths": { "ai": ["./node_modules/ai"] }
  },
  "include": ["src"]
}
