# Template only: nothing in this repository loads a .env file. Copy it and export
# the values yourself before starting the example, e.g.
#
#   cp .env.example .env
#   set -a; . ./.env; set +a
#
OPENAI_API_KEY=sk-...
# Optional: the model behind every example session (default gpt-6-astra)
# OPENAI_AGENTS_MODEL=gpt-6-astra
# PORT=8027
