# Optional configuration. Replay needs no .env or API key.
E2E_MODEL=replay
STREAM_FC_ARGS=0
REPLAY_CHUNK_DELAY_S=0.03

# Live models via LiteLLM: set the model and credentials for your provider.
# E2E_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=
# E2E_MODEL=anthropic/claude-sonnet-4-5
# ANTHROPIC_API_KEY=

# Azure: use your deployment name, not the model name.
# E2E_MODEL=azure/your-deployment-name
# AZURE_API_KEY=
# AZURE_API_BASE=https://your-resource.openai.azure.com
# AZURE_API_VERSION=2024-10-21
# Optional, where supported by the selected model:
# E2E_REASONING_EFFORT=none

# Gemini Developer API: for comparing provider behavior. It may return only
# complete tool arguments. The API rejects the streaming flag in this setup;
# keep GEMINI_SEND_STREAM_FLAG=0 unless explicitly probing that rejection.
# E2E_MODEL=gemini-flash-latest
# GOOGLE_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GEMINI_SEND_STREAM_FLAG=0

# Shell-only runner options (export these or prefix ./run.sh):
# ADK_VERSION=2.10.0 PORT=8010 NO_OPEN=1 ./run.sh
