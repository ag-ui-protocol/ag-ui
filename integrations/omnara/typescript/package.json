{
  "name": "@ag-ui/omnara",
  "version": "0.0.1",
  "description": "AG-UI integration for Omnara (hosted, durable agents)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ag-ui-protocol/ag-ui.git",
    "directory": "integrations/omnara/typescript"
  },
  "keywords": [
    "ag-ui",
    "omnara",
    "copilotkit",
    "agents",
    "ai"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "git clean -fdX --exclude=\"!.env\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:exports": "publint --strict && attw --pack",
    "link:global": "pnpm link --global",
    "unlink:global": "pnpm unlink --global"
  },
  "dependencies": {
    "@omnara/sdk": "^0.1.26",
    "rxjs": "7.8.1",
    "yaml": "^2.8.4"
  },
  "peerDependencies": {
    "@ag-ui/core": ">=1.0.0",
    "@ag-ui/client": ">=1.0.0"
  },
  "devDependencies": {
    "@ag-ui/core": "workspace:*",
    "@ag-ui/client": "workspace:*",
    "@types/node": "^20.11.19",
    "publint": "^0.3.12",
    "@arethetypeswrong/cli": "^0.17.4",
    "vitest": "^4.0.18",
    "tsdown": "^0.20.1",
    "typescript": "^5.3.3"
  },
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  }
}
