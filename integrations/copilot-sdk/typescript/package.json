{
  "name": "@ag-ui/copilot-sdk",
  "version": "0.0.1",
  "description": "Native GitHub Copilot SDK sessions exposed through the AG-UI protocol",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "dist-example", "examples", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build-example": "tsc -p tsconfig.example.json",
    "start:example": "node dist-example/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ag-ui/core": "workspace:*",
    "@ag-ui/client": "workspace:*",
    "@github/copilot-sdk": "1.0.14",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "5.8.2",
    "vitest": "^4.0.18"
  },
  "engines": { "node": "^20.19.0 || >=22.12.0" },
  "nx": {
    "targets": {
      "build-example": {
        "dependsOn": ["build"],
        "outputs": ["{projectRoot}/dist-example"]
      }
    }
  }
}
