# Environment variables for Microsoft Agent Framework .NET examples

# Required: OpenAI (or OpenAI-compatible) configuration
OPENAI_API_KEY=your_api_key_here

# Optional: model to use (defaults to gpt-4o)
# OPENAI_CHAT_MODEL_ID=gpt-4o

# Optional: OpenAI-compatible endpoint (e.g. aimock for the Dojo e2e suite)
# OPENAI_BASE_URL=http://localhost:5555/v1

# Server Configuration (default port from launchSettings.json: HTTP=5018)
# ASPNETCORE_URLS=http://localhost:5018
