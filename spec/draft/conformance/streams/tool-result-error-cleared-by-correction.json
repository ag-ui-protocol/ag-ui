{
  "name": "tool-result-error-cleared-by-correction",
  "area": "tool-calls",
  "description": "a failed TOOL_CALL_RESULT is corrected by a later MESSAGES_SNAPSHOT that restates the tool message with new content and no error; the snapshot replaces the consumer's copy by id, so the correction stands and the streamed error does not survive it. content pins the replacement against a client that kept the streamed copy; messageAbsentPaths pins it against one that merged the snapshot over that copy",
  "specPage": "/spec/draft/events/tool-calls#error",
  "kill": "merge a MESSAGES_SNAPSHOT message over the streamed copy with the same id ({...streamed, ...snapshot}), instead of replacing it",
  "stream": [
    {
      "type": "RUN_STARTED",
      "threadId": "t-toolerr-corrected",
      "runId": "toolerr-corrected-r1"
    },
    {
      "type": "TOOL_CALL_START",
      "toolCallId": "toolerr-corrected-c1",
      "toolCallName": "search",
      "parentMessageId": "toolerr-corrected-a1"
    },
    {
      "type": "TOOL_CALL_ARGS",
      "toolCallId": "toolerr-corrected-c1",
      "delta": "{\"q\":\"ag-ui\"}"
    },
    {
      "type": "TOOL_CALL_END",
      "toolCallId": "toolerr-corrected-c1"
    },
    {
      "type": "TOOL_CALL_RESULT",
      "messageId": "toolerr-corrected-t1",
      "toolCallId": "toolerr-corrected-c1",
      "content": "Error: upstream returned 502",
      "error": "upstream returned 502"
    },
    {
      "type": "MESSAGES_SNAPSHOT",
      "messages": [
        {
          "id": "toolerr-corrected-a1",
          "role": "assistant",
          "toolCalls": [
            {
              "id": "toolerr-corrected-c1",
              "type": "function",
              "function": {
                "name": "search",
                "arguments": "{\"q\":\"ag-ui\"}"
              }
            }
          ]
        },
        {
          "id": "toolerr-corrected-t1",
          "role": "tool",
          "toolCallId": "toolerr-corrected-c1",
          "content": "3 results found on retry."
        }
      ]
    },
    {
      "type": "RUN_FINISHED",
      "threadId": "t-toolerr-corrected",
      "runId": "toolerr-corrected-r1"
    }
  ],
  "expect": {
    "outcome": "completed",
    "noWarnings": true,
    "messageCount": 2,
    "messages": [
      {
        "id": "toolerr-corrected-a1",
        "role": "assistant"
      },
      {
        "id": "toolerr-corrected-t1",
        "role": "tool",
        "toolCallId": "toolerr-corrected-c1",
        "content": "3 results found on retry."
      }
    ],
    "messageAbsentPaths": ["1.error"]
  }
}
